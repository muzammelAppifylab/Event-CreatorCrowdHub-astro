---
/**
 * The branded 404 body — rendered by `pages/404.astro` for any address with no
 * page, and by the post page for an unknown slug. Both set a 404 status.
 * Port of the original app's `NotFoundScreen` (stacked poster headline, one sentence, one action).
 */
import {copy} from '../config/copy';
import type {Site} from '../lib/types';
import ErrorScreen from './ErrorScreen.astro';

interface Props {
  site: Site | null;
}

const c = copy.errors.notFound;
---

<ErrorScreen poster={c.poster} description={c.body} action={{href: '/', label: c.action}} />
