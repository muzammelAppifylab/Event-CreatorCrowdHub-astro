---
/** "Already RSVP'd? Email me my link": always answers the same, whether or not the email has an RSVP. */
interface Props {
  slug: string;
}
const {slug} = Astro.props;
---

<form id="manage-link-form" class="g-form" novalidate data-slug={slug}>
  <div class="field">
    <label for="manage-link-email">Your email</label>
    <input id="manage-link-email" name="email" type="email" autocomplete="email" inputmode="email" />
  </div>
  <p class="notice" data-form-status hidden></p>
  <div class="g-form-end"><button class="g-btn g-btn-outline g-btn-lg" type="submit">Send my link</button></div>
</form>

<script>
  import {replaceWithMessage} from '../../lib/account';
  import {bindForm, postJson} from '../../lib/form';
  import {rules} from '../../lib/rules';
  import {siteFetch} from '../../platform/browser';

  document.addEventListener('astro:page-load', () => {
    const form = document.querySelector<HTMLFormElement>('#manage-link-form');
    if (!form || form.dataset.bound) return;
    form.dataset.bound = '1';
    bindForm(form, {
      rules: {email: [rules.required('Enter a valid email address'), rules.email('Enter a valid email address')]},
      pendingLabel: 'Sending…',
      async submit(values) {
        const {result} = await postJson(siteFetch, `/site-api/rsvp/events/${form.dataset.slug}/manage-link`, {email: values.email});
        if (result.ok) replaceWithMessage(form, result.message ?? 'Check your inbox.');
        return result;
      },
    });
  });
</script>
