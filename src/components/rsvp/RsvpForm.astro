---
/**
 * The RSVP form (create in the event page's sheet and on the invite landing, edit on `/r/<token>`).
 * Server-rendered from the RSVP view; the script below binds it with `bindForm` (in-place errors,
 * pending button, focus on the first wrong field) and talks to `/site-api/rsvp/*`. Honeypot:
 * `website` is hidden and must stay empty. Markup and copy follow the original app's RsvpForm
 * ("(required)" marks; no Going/Maybe/Can’t go choice, an RSVP always means going); the field names and ids are the API contract.
 */
import {formatMoney} from '../../lib/format';
import type {AnswerValue, RsvpEventView} from '../../lib/rsvp-types';

interface Props {
  view: RsvpEventView;
  mode: 'create' | 'edit';
  /** Edit mode: the guest's manage token (from the URL). */
  token?: string;
  /** From an invite landing: sent with the RSVP so a private event accepts it. */
  inviteToken?: string;
  /**
   * A private event opened with an invite: only the invited address may RSVP (the server refuses any
   * other, audit M-5), so the email shows read-only. Only on the invitee's own (uncached) invite page.
   */
  lockEmail?: boolean;
  /** The host's name, for the marketing-consent line ("Send me news and offers from …"). */
  hostName?: string;
  values?: {
    name?: string;
    email?: string;
    response?: string;
    plusOnes?: number;
    ticketTypeId?: string | null;
    marketingConsent?: boolean;
    answers?: Record<string, AnswerValue>;
  };
}

const {view, mode, token, inviteToken, lockEmail = false, hostName = 'this host', values = {}} = Astro.props;
const editing = mode === 'edit';
const emailLocked = editing || (lockEmail && !!values.email);
const emailHint = editing
  ? 'To use a different email, cancel this RSVP and RSVP again.'
  : emailLocked
    ? `This invitation is for ${values.email}.`
    : 'Your confirmation and reminders go here.';
const id = editing ? 'rsvp-edit' : 'rsvp-create';
const answers = values.answers ?? {};
const anyPaid = view.ticketTypes.some(t => t.priceCents > 0);
const action = editing ? `/site-api/rsvp/manage/${token}` : `/site-api/rsvp/events/${view.slug}`;
const questionMeta = view.questions.map(q => ({id: q.id, type: q.type, required: q.required}));
const priceLabel = (cents: number, currency: string) => (cents > 0 ? formatMoney(cents, currency) : 'Free');
const full = view.seatsLeft === 0;
const submitLabel = editing
  ? 'Save changes'
  : full && view.waitlistEnabled
    ? 'Join waitlist'
    : view.approvalRequired
      ? 'Request to join'
      : anyPaid
        ? 'Continue to payment'
        : 'Save my seat';
const maxPlus = view.maxPlusOnes;
const plusCap = view.seatsLeft === null || (full && view.waitlistEnabled) ? maxPlus : Math.max(0, Math.min(maxPlus, view.seatsLeft - 1));
const optional = (required: boolean) => (required ? 'required' : 'optional');
---

<form
  id={id}
  class="g-form"
  novalidate
  data-rsvp-form
  data-mode={mode}
  data-action={action}
  data-invite={inviteToken ?? ''}
  data-max-plus={String(view.maxPlusOnes)}
  data-any-paid={anyPaid ? '1' : ''}
  data-approval={view.approvalRequired ? '1' : ''}
  data-waitlist={full && view.waitlistEnabled ? '1' : ''}
  data-questions={JSON.stringify(questionMeta)}
>
  <input type="hidden" name="response" value="going" />

  <div class="field">
    <label for={`${id}-name`}>Your name <span class="g-optional">(required)</span></label>
    <input id={`${id}-name`} name="name" autocomplete="name" value={values.name ?? ''} maxlength="120" aria-required="true" />
  </div>
  <div class="field">
    <label for={`${id}-email`}>Email <span class="g-optional">(required)</span></label>
    <input
      id={`${id}-email`}
      name="email"
      type="email"
      autocomplete="email"
      inputmode="email"
      autocapitalize="none"
      spellcheck="false"
      value={values.email ?? ''}
      readonly={emailLocked}
      aria-required="true"
      aria-readonly={emailLocked ? 'true' : undefined}
      aria-describedby={`${id}-email-hint`}
    />
    <p class="field-hint" id={`${id}-email-hint`}>
      {emailHint}
    </p>
  </div>

  {
    view.ticketTypes.length > 0 && !editing && (
      <div class="field">
        <label for={`${id}-ticket`}>Ticket</label>
        <select id={`${id}-ticket`} name="ticketTypeId">
          <option value="">{anyPaid ? 'Choose a ticket' : 'No preference'}</option>
          {view.ticketTypes.map(t => {
            const out = t.salesEnded || t.remaining === 0;
            return (
              <option value={t.id} disabled={out} selected={values.ticketTypeId === t.id}>
                {t.name} · {priceLabel(t.priceCents, t.currency)}
                {t.salesEnded ? ' (sales ended)' : t.remaining === 0 ? ' (sold out)' : t.remaining !== null && t.remaining <= 10 ? ` (${t.remaining} left)` : ''}
              </option>
            );
          })}
        </select>
      </div>
    )
  }

  {
    view.maxPlusOnes > 0 && (
      <div class="field">
        <label for={`${id}-plus`}>Bringing anyone?</label>
        <select id={`${id}-plus`} name="plusOnes" aria-describedby={`${id}-plus-hint`}>
          {Array.from({length: view.maxPlusOnes + 1}, (_, n) => (
            <option value={String(n)} selected={(values.plusOnes ?? 0) === n} disabled={n > plusCap && (values.plusOnes ?? 0) !== n}>
              {n === 0 ? 'Just me' : `Me + ${n}`}
            </option>
          ))}
        </select>
        <p class="field-hint" id={`${id}-plus-hint`}>
          {plusCap < maxPlus
            ? `Only ${view.seatsLeft} ${view.seatsLeft === 1 ? 'seat' : 'seats'} left, so the list is shorter.`
            : `Up to ${maxPlus}. Each guest takes a seat.`}
        </p>
      </div>
    )
  }

  {
    view.questions.map(q => {
      const qid = `${id}-q-${q.id}`;
      const value = answers[q.id];
      return q.type === 'checkbox' ? (
        <div class="g-check">
          <input id={qid} name={`q_${q.id}`} type="checkbox" checked={value === true} />
          <label for={qid}>
            {q.label} <span class="g-optional">({optional(q.required)})</span>
          </label>
        </div>
      ) : (
        <div class="field">
          <label for={qid}>
            {q.label} <span class="g-optional">({optional(q.required)})</span>
          </label>
          {q.type === 'long_text' ? (
            <textarea id={qid} name={`q_${q.id}`} rows="3" maxlength="2000">{typeof value === 'string' ? value : ''}</textarea>
          ) : q.type === 'short_text' ? (
            <input id={qid} name={`q_${q.id}`} maxlength="200" value={typeof value === 'string' ? value : ''} />
          ) : (
            <>
              <select id={qid} name={`q_${q.id}`} {...(q.type === 'multi_choice' ? {multiple: true} : {})}>
                {q.type === 'single_choice' && <option value="">Choose one</option>}
                {q.options.map(o => (
                  <option value={o} selected={Array.isArray(value) ? value.includes(o) : value === o}>
                    {o}
                  </option>
                ))}
              </select>
              {q.type === 'multi_choice' && <p class="field-hint">Hold Ctrl (Cmd on a Mac) to pick several.</p>}
            </>
          )}
        </div>
      );
    })
  }

  <div class="g-check">
    <input id={`${id}-consent`} name="marketingConsent" type="checkbox" checked={values.marketingConsent !== false} aria-describedby={`${id}-consent-hint`} />
    <div class="g-check-text">
      <label for={`${id}-consent`}>Send me news and offers from {hostName}</label>
      <p class="g-check-hint" id={`${id}-consent-hint`}>Optional. Unsubscribe any time.</p>
    </div>
  </div>

  <div hidden aria-hidden="true">
    <label for={`${id}-website`}>Leave this empty</label>
    <input id={`${id}-website`} name="website" tabindex="-1" autocomplete="off" />
  </div>

  <p class="notice" data-form-status hidden></p>
  <div class="g-form-end">
    <button class="g-btn g-btn-lg" type="submit">{submitLabel}</button>
  </div>
</form>

<script>
  import {bindForm, type SubmitResult} from '../../lib/form';
  import {type Rule, rules} from '../../lib/rules';
  import {siteFetch} from '../../platform/browser';

  type Meta = {id: string; type: string; required: boolean};

  /** Swaps the form for the confirmation panel: the API answers 202 `check_email` for every email. */
  function showCheckEmail(form: HTMLFormElement, fallback: string) {
    const email = (form.elements.namedItem('email') as HTMLInputElement | null)?.value.trim() ?? '';
    const waitlist = !!form.dataset.waitlist;
    const approval = !!form.dataset.approval;
    const paid = !!form.dataset.anyPaid;
    const panel = document.createElement('div');
    panel.className = 'g-confirm';
    panel.setAttribute('role', 'status');
    panel.tabIndex = -1;
    const add = (tag: string, className: string) => {
      const el = document.createElement(tag);
      el.className = className;
      panel.append(el);
      return el;
    };
    add('h3', 'g-confirm-title').textContent = 'Check your email';
    const lead = add('p', 'g-confirm-body');
    if (email) {
      const strong = document.createElement('strong');
      strong.textContent = email;
      lead.append('We sent a link to ', strong, ' to view or change your RSVP.');
    } else lead.textContent = fallback;
    const steps = add('ul', 'g-confirm-steps');
    const items = [
      approval
        ? `The host reviews every request. We'll email ${email || 'you'} as soon as they decide.`
        : waitlist
          ? paid
            ? "If a seat opens up, we'll email you a link to claim it. You'll have 24 hours to pay."
            : "If a seat opens up, you'll get it automatically and we'll email you."
          : 'Open the link in that email to see your RSVP, add it to your calendar or change your reply.',
      'Nothing there? Check your spam folder.',
    ];
    for (const text of items) {
      const li = document.createElement('li');
      li.textContent = text;
      steps.append(li);
    }
    const done = document.createElement('button');
    done.type = 'button';
    done.className = 'g-btn g-btn-outline g-btn-lg';
    done.textContent = 'Done';
    done.addEventListener('click', () => form.closest('dialog')?.close());
    panel.append(done);
    form.replaceWith(panel);
    panel.focus();
  }

  document.addEventListener('astro:page-load', () => {
    for (const form of document.querySelectorAll<HTMLFormElement>('form[data-rsvp-form]')) {
      if (form.dataset.bound) continue;
      form.dataset.bound = '1';
      const editing = form.dataset.mode === 'edit';
      const metas = JSON.parse(form.dataset.questions ?? '[]') as Meta[];
      const maxPlus = Number(form.dataset.maxPlus ?? '0');
      const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null;
      const declining = () => field('response')?.value === 'not_going';

      const ruleSet: Record<string, Rule[]> = {
        name: [rules.required('Add your name'), rules.maxLength(120)],
        // The email is the RSVP's identity: not editable on the manage page.
        ...(editing ? {} : {email: [rules.required('Enter a valid email address'), rules.email('Enter a valid email address')]}),
      };
      if (field('plusOnes')) {
        ruleSet.plusOnes = [
          value => (Number(value) > maxPlus ? `You can bring up to ${maxPlus} ${maxPlus === 1 ? 'guest' : 'guests'}.` : null),
        ];
      }
      if (field('ticketTypeId') && form.dataset.anyPaid) ruleSet.ticketTypeId = [rules.required('Choose a ticket')];
      for (const q of metas) {
        if (q.required && q.type !== 'checkbox') {
          ruleSet[`q_${q.id}`] = [value => (declining() ? null : rules.required('This question needs an answer')(value))];
        }
      }

      const collect = (values: Record<string, string>) => {
        const answers: Record<string, string | string[] | boolean> = {};
        for (const q of metas) {
          const el = field(`q_${q.id}`);
          if (!el) continue;
          if (q.type === 'checkbox') answers[q.id] = (el as HTMLInputElement).checked;
          else if (q.type === 'multi_choice') answers[q.id] = [...(el as HTMLSelectElement).selectedOptions].map(o => o.value);
          else answers[q.id] = el.value;
        }
        return {
          name: values.name,
          email: values.email ?? field('email')?.value ?? '',
          response: values.response,
          plusOnes: Number(values.plusOnes ?? '0'),
          ...(values.ticketTypeId ? {ticketTypeId: values.ticketTypeId} : {}),
          answers,
          marketingConsent: (field('marketingConsent') as HTMLInputElement | null)?.checked ?? false,
          website: values.website ?? '',
          ...(form.dataset.invite ? {inviteToken: form.dataset.invite} : {}),
        };
      };

      bindForm(form, {
        rules: ruleSet,
        pendingLabel: editing ? 'Saving…' : 'Sending…',
        async submit(values): Promise<SubmitResult> {
          let res: Response;
          try {
            res = await siteFetch(form.dataset.action!, {
              method: editing ? 'PATCH' : 'POST',
              headers: {'content-type': 'application/json'},
              body: JSON.stringify(collect(values)),
            });
          } catch {
            return {ok: false, message: 'The site did not answer. Check your connection and try again.'};
          }
          const data = (await res.json().catch(() => null)) as Record<string, unknown> | null;
          if (res.ok) {
            if (editing) {
              // Maybe -> Going on a paid ticket: pay first, like a new RSVP.
              if (typeof data?.checkoutUrl === 'string' && data.checkoutUrl) return {ok: true, redirect: data.checkoutUrl};
              return {ok: true, redirect: `${location.pathname}?saved=1`};
            }
            if (data?.status === 'check_email') {
              if (typeof data.checkoutUrl === 'string' && data.checkoutUrl) return {ok: true, redirect: data.checkoutUrl};
              return {ok: true, message: String(data.message ?? 'Check your email for a link to change your RSVP.')};
            }
            const next = (typeof data?.checkoutUrl === 'string' && data.checkoutUrl) || (typeof data?.managePath === 'string' && data.managePath);
            return next ? {ok: true, redirect: next} : {ok: true, message: 'Thanks, your RSVP is in.'};
          }
          // Server field errors: `answers.<questionId>` lands on that question's control.
          const fields: Record<string, string> = {};
          for (const [key, message] of Object.entries((data?.fields as Record<string, string> | undefined) ?? {})) {
            fields[key.startsWith('answers.') ? `q_${key.slice(8)}` : key] = message;
          }
          return {
            ok: false,
            message: typeof data?.message === 'string' ? data.message : `Something went wrong (${res.status}). Try again.`,
            fields,
          };
        },
        done(message) {
          if (!editing && message) showCheckEmail(form, message);
        },
      });
      // The source's banner above the submit bar when answers need a look (bindForm has already validated).
      form.addEventListener('submit', () => {
        const status = form.querySelector<HTMLElement>('[data-form-status]');
        if (!status || !form.querySelector('[aria-invalid="true"]')) return;
        status.textContent = 'Some answers need a look before we can save.';
        status.className = 'notice notice-error';
        status.setAttribute('role', 'alert');
        status.hidden = false;
      });
    }
  });
</script>
