---
/**
 * The few Lucide icons the guest pages use (the source app draws them with lucide-react), as inline
 * SVG: no icon library, no request. Decorative unless `label` is given. Sized by the `.g-icon` rules
 * in public.css (1rem by default; `.g-icon-5` etc. for the wells).
 */
const paths = {
  'monitor-play': '<path d="M12 17v4"/><path d="M8 21h8"/><path d="m10 7 5 3-5 3Z"/><rect width="20" height="14" x="2" y="3" rx="2"/>',
  'map-pin': '<path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/>',
