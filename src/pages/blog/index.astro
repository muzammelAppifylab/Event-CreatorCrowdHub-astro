---
/**
 * The blog, as a publication: hero, featured story, a grid of cards. Built from
 * the Markdown files in `src/content/blog/` (PRERENDERED: a new post goes live
 * with the next Publish). To add a post, add a Markdown file.
 */
import PostCard from '../../components/PostCard.astro';
import Base from '../../layouts/Base.astro';
import {publishedPosts} from '../../lib/posts';
import {staticContext} from '../../server/page';

export const prerender = true;

const {site, viewer} = await staticContext(Astro.request);
const name = site?.name ?? 'CreatorCrowdHub';
const [featured, ...rest] = await publishedPosts();
---

<Base site={site} viewer={viewer} isStatic title="Blog" description={`Stories and updates from ${name}.`}>
  <main id="main" tabindex="-1" class="bl">
    <header class="wrap bl-hero">
      <p class="eyebrow">The blog</p>
      <h1>Stories, guides and updates</h1>
      <p class="bl-lede">Ideas for running better events, and news from <span data-brand-text="{name}">{name}</span>.</p>
    </header>

    <section class="wrap" aria-label="Posts">
      {featured ? <PostCard post={featured} featured /> : <p class="bl-empty">No posts published yet.</p>}

      {
        rest.length > 0 && (
          <>
            <h2 class="bl-subhead">More to read</h2>
            <div class="bl-grid">{rest.map(post => <PostCard post={post} />)}</div>
          </>
        )
      }
    </section>

    <section class="wrap bl-cta" data-guest-only>
      <div>
        <h2>Host your next event with us</h2>
        <p>Branded pages, invites, RSVPs and live polls behind one link.</p>
      </div>
      <a class="button button-lg" href="/account/register/?next=%2Fblog%2F" data-astro-prefetch>Create an account</a>
    </section>
  </main>
</Base>
