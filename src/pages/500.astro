---
/**
 * What a visitor sees when a page fails on the server (an error thrown while
 * rendering), instead of an empty answer. Astro renders it with a 500 status.
 * It reads nothing (no brand, no visitor, no database): whatever broke the
 * page must not break this one too. The error itself is never shown here;
 * it is in the Worker's log.
 *
 * In `npm run dev` and the editor Preview you see Astro's error overlay
 * instead, with the stack trace.
 */
import ErrorScreen from '../components/ErrorScreen.astro';
import {copy} from '../config/copy';
import Base from '../layouts/Base.astro';
import {GUEST} from '../platform/auth';

const c = copy.errors.crash;
---

<Base site={null} viewer={GUEST} title="Something went wrong" noindex guest>
  <ErrorScreen poster={c.poster} description={c.body} action={{href: '/', label: 'Back to home', reload: true}} />
</Base>
