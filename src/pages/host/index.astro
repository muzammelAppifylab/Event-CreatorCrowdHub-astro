---
/**
 * Public host page: every upcoming public event of this site as one branded page
 * (port of CreatorCrowdHub `features/host-page`: avatar, "Events by …", a poster-first tile grid, an
 * empty state). SSR from `GET /site-api/events` (in-process) plus
 * the public brand (`GET /site-api/event-settings/brand`: colour and font preset only).
 * "Later events" follows the keyset cursor (`?before=`).
 */
import EventCard from '../../components/EventCard.astro';
import GIcon from '../../components/GIcon.astro';
import Base from '../../layouts/Base.astro';
import {initials} from '../../lib/format';
import {guestCopy} from '../../lib/guest-format';
import type {EventsPage} from '../../lib/types';
import {parseKeysetCursor} from '../../lib/text';
import {backend, read} from '../../server/backend';
import {pageContext} from '../../server/page';

// A crafted or broken `?before=` cursor is the visitor's error (400), not an outage (503):
// show the first page with that status instead of asking the API.
const rawBefore = Astro.url.searchParams.get('before') ?? undefined;
const badCursor = parseKeysetCursor(rawBefore) === 'invalid';
const before = badCursor ? undefined : rawBefore;
const api = backend(Astro.request);
const [{site, viewer}, result, brand, pastResult] = await Promise.all([
  pageContext(Astro.request, Astro.response),
  read<EventsPage>(api.events.$get({query: {before, q: undefined, format: undefined, when: undefined}})),
  read<{brandColor: string | null; fontPreset: string}>(api['event-settings'].brand.$get()),
  before ? Promise.resolve(null) : read<EventsPage>(api.events.past.$get()),
]);
const past = pastResult?.events ?? [];
const events = result?.events ?? [];
if (badCursor) Astro.response.status = 400;
else if (!result) Astro.response.status = 503;
const color = brand?.brandColor && /^#[0-9a-fA-F]{6}$/.test(brand.brandColor) ? brand.brandColor : null;
const name = site?.name ?? 'Our events';
---

<Base site={site} viewer={viewer} guest brand={brand} title={guestCopy.hostPage.title(name)} description={`Upcoming events hosted by ${name}. RSVP in a minute.`}>
  <main id="main" tabindex="-1" class="g-main" data-brand={color ?? undefined} data-font={brand?.fontPreset}>
    <div class="page-container g-host-page">
      <header class="g-host-head">
        <span class="g-avatar g-avatar-16">
          {site?.logo ? <img src={site.logo} alt="" /> : initials(name)}
        </span>
        <h1 class="type-display g-display">{guestCopy.hostPage.title(name)}</h1>
      </header>

      {
        !result ? (
          <p class="g-notice g-notice-error" role="alert">Events are not available right now.</p>
        ) : events.length === 0 ? (
          <div class="g-empty">
            <span class="g-empty-icon"><GIcon name="calendar-x" class="g-icon-5" /></span>
            <div class="g-empty-text">
              <p class="g-title-sm">{guestCopy.hostPage.emptyTitle}</p>
              <p class="g-body-sm g-muted">{guestCopy.hostPage.emptyBody}</p>
            </div>
          </div>
        ) : (
          <section aria-labelledby="host-upcoming" class="g-list-section">
            <h2 id="host-upcoming">{guestCopy.hostPage.upcoming}</h2>
            <ul class="g-grid">
              {events.map(e => <li><EventCard event={e} /></li>)}
            </ul>
          </section>
        )
      }
      {
        past.length > 0 && (
          <details class="g-list-section g-past">
            <summary>{guestCopy.hostPage.past}</summary>
            <ul class="g-grid">
              {past.map(e => <li><EventCard event={e} /></li>)}
            </ul>
          </details>
        )
      }
      {
        result?.next && (
          <nav class="g-pager" aria-label="More events">
            <a class="g-btn g-btn-outline g-btn-lg" href={`/host/?before=${encodeURIComponent(result.next)}`}>
              Later events
              <GIcon name="arrow-right" />
            </a>
          </nav>
        )
      }
    </div>
  </main>
</Base>

