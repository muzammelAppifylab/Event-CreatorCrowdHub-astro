---
/**
 * Invite landing (`/i/<token>`): the link in an invitation email. Works for private events too (the invite
 * token is what makes them visible). It shows the event page of the original app with the RSVP form
 * pre-filled with the invitee; the token travels with the RSVP so it counts as invited. Never cached,
 * never indexed. A bad or bounced invite is a real 404.
 */
import ErrorScreen from '../../components/ErrorScreen.astro';
import EventView from '../../components/EventView.astro';
import {rsvpRead} from '../../components/rsvp/server';
import Base from '../../layouts/Base.astro';
import {routeCopy} from '../../lib/guest-format';
import type {InviteView} from '../../lib/rsvp-types';
import {pageContext} from '../../server/page';

const token = Astro.params.token ?? '';
const [{site, viewer}, found] = await Promise.all([
  pageContext(Astro.request, Astro.response),
  rsvpRead<InviteView>(Astro.request, `/invite/${encodeURIComponent(token)}`),
]);
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
Astro.response.headers.set('X-Robots-Tag', 'noindex');
const data = found.data;
const missing = !data && found.status === 404;
if (!data) {
  Astro.response.status = missing ? 404 : 503;
  if (!missing) Astro.response.headers.set('Retry-After', '60');
}
const event = data?.event;
const incomplete = routeCopy.inviteIncomplete;
const failed = routeCopy.loadFailed;
---

{
  data && event ? (
    <Base site={site} viewer={viewer} title={`You’re invited: ${event.title}`} noindex secretInUrl guest>
      <main id="main" tabindex="-1" class="g-main">
        <EventView
          event={event}
          rsvp={event}
          site={site}
          invite={{name: data.invite.name, email: data.invite.email, token: data.invite.token, alreadyResponded: data.alreadyResponded}}
        />
      </main>
    </Base>
  ) : missing ? (
    <Base site={site} viewer={viewer} title="Invite not found" noindex guest>
      <ErrorScreen poster={incomplete.poster} description={incomplete.body} action={{href: '/', label: incomplete.action}} />
    </Base>
  ) : (
    <Base site={site} viewer={viewer} title="Not available right now" noindex guest>
      <ErrorScreen poster={failed.poster} description={failed.body} action={{href: `/i/${encodeURIComponent(token)}/`, label: failed.action, prefetch: false, reload: true}} />
    </Base>
  )
}
