---
/**
 * The home page: PRERENDERED (built once, served as a static file, no server
 * work per visit) and made of sections. Words in `HOME`, `src/content/site.ts`;
 * styles in `src/styles/home.css` (every rule under `.home`).
 *
 * What changes often is filled in by the browser after load, from the Site API:
 *   - the visitor (`<Base isStatic>`): signed-in users see "Open your dashboard"
 *     (`data-user-only`), guests "Create an account" (`data-guest-only`)
 *   - the next 3 public events and open roles (`data-live` sections, below). Events are
 *     public data but change often, so they load client-side from `GET /site-api/events`
 *     and are never baked into this static file.
 * The latest posts come from `src/content/blog/` at build time.
 * A section with no data stays hidden.
 */
import '../styles/home.css';
import '../styles/browse.css';

import Cover from '../components/Cover.astro';
import HeroVisual from '../components/home/HeroVisual.astro';
import Icon, {type IconName} from '../components/home/Icon.astro';
import {HOME, withName} from '../content/site';
import Base from '../layouts/Base.astro';
import {staticContext} from '../server/page';
import {formatDate, postHref, publishedPosts} from '../lib/posts';

export const prerender = true;

const {site, viewer} = await staticContext(Astro.request);
const name = site?.name ?? 'CreatorCrowdHub';
const latest = (await publishedPosts()).slice(0, 3);

// The headline, split around the highlighted words (`HOME.hero.highlight`).
const {title, highlight} = HOME.hero;
const at = highlight ? title.indexOf(highlight) : -1;
const headline =
  at < 0
    ? {before: title, mark: '', after: ''}
    : {before: title.slice(0, at), mark: highlight, after: title.slice(at + highlight.length)};
---

<Base site={site} viewer={viewer} isStatic>
  <main id="main" tabindex="-1" class="home">
    <section class="home-hero">
      <div class="wrap home-hero-grid">
        <div class="home-hero-copy">
          <p class="home-badge"><span class="home-badge-dot" aria-hidden="true"></span><span data-brand-text={HOME.hero.eyebrow}>{withName(HOME.hero.eyebrow, name)}</span></p>
          <h1>
            {headline.before}{headline.mark && <mark>{headline.mark}</mark>}{headline.after}
          </h1>
          <p class="home-lede">{HOME.hero.body}</p>
          <ul class="home-points">
            {HOME.hero.points.map(point => <li><Icon name="check" size={16} />{point}</li>)}
          </ul>
          <div class="home-actions" data-guest-only>
            <a class="button home-button-lg" href="/account/register/" data-astro-prefetch>
              {HOME.hero.guest.primary}
              <Icon name="arrow-right" size={18} />
            </a>
            <a class="button ghost home-button-lg" href="#how">{HOME.hero.guest.secondary}</a>
          </div>
          <div class="home-actions" data-user-only hidden>
            <a class="button home-button-lg" href="/dashboard">
              {HOME.hero.user.primary}
              <Icon name="arrow-right" size={18} />
            </a>
            <a class="button ghost home-button-lg" href="/events/">{HOME.hero.user.secondary}</a>
          </div>
          <p class="home-note" data-guest-only>{HOME.hero.note}</p>
          <div class="home-find">
            <p class="home-find-label">{HOME.hero.searchLabel}</p>
            <form class="browse-search home-search" action="/events/" method="get" role="search">
              <label class="sr-only" for="home-search">Search events</label>
              <svg class="browse-search-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" /></svg>
              <input id="home-search" class="browse-search-input" type="search" name="q" maxlength="80" placeholder={HOME.search.placeholder} autocomplete="off" />
              <button class="button" type="submit">Search</button>
            </form>
            <ul class="home-quick" aria-label="Quick filters">
              {HOME.search.quick.map(chip => <li><a class="browse-chip" href={chip.href}>{chip.label}</a></li>)}
            </ul>
          </div>
        </div>
        <div class="home-hero-visual">
          <HeroVisual name={name} />
          {
            HOME.visual.floats.map((card, i) => (
              <div class:list={['home-float', `home-float-${i + 1}`]} aria-hidden="true">
                <span class="home-float-icon"><Icon name={card.icon as IconName} size={18} /></span>
                <span>
                  <strong>{card.title}</strong>
                  <small>{card.text}</small>
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="home-section" data-live="events" aria-labelledby="events-title" hidden>
      <div class="wrap">
        <div class="home-head home-head-row">
          <h2 id="events-title">{HOME.events.title}</h2>
          <a class="home-more" href="/events/">
            {HOME.events.link}
            <Icon name="arrow-right" size={16} />
          </a>
        </div>
        <ul class="home-event-grid" data-list></ul>
      </div>
    </section>

    <section class="home-section" aria-labelledby="features-title">
      <div class="wrap">
        <div class="home-head">
          <p class="home-eyebrow">{HOME.features.eyebrow}</p>
          <h2 id="features-title">{HOME.features.title}</h2>
          <p class="home-sub">{HOME.features.body}</p>
        </div>
        <ul class="home-features">
          {
            HOME.features.items.map(feature => (
              <li class="home-feature">
                <span class="home-icon-tile">
                  <Icon name={feature.icon as IconName} />
                </span>
                <h3>{feature.title}</h3>
                <p>{feature.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="home-section home-band" id="how" aria-labelledby="how-title">
      <div class="wrap">
        <div class="home-head">
          <p class="home-eyebrow">{HOME.how.eyebrow}</p>
          <h2 id="how-title">{HOME.how.title}</h2>
        </div>
        <ol class="home-steps">
          {
            HOME.how.steps.map((step, i) => (
              <li class="home-step">
                <span class="home-step-num">{String(i + 1).padStart(2, '0')}</span>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    {
      latest.length > 0 && (
        <section class="home-section" aria-labelledby="blog-title">
          <div class="wrap">
            <div class="home-head home-head-row">
              <h2 id="blog-title">{HOME.blog.title}</h2>
              <a class="home-more" href="/blog/" data-astro-prefetch>
                {HOME.blog.link}
                <Icon name="arrow-right" size={16} />
              </a>
            </div>
            <div class="grid grid-3">
              {latest.map(post => (
                <a class="post-card" href={postHref(post)} data-astro-prefetch>
                  {post.data.cover ? (
                    <Cover class="cover" src={post.data.cover} alt={post.data.coverAlt} width={640} height={360} sizes="(min-width: 1100px) 350px, (min-width: 640px) 50vw, 100vw" />
                  ) : (
                    <span class="cover cover-empty" aria-hidden="true" />
                  )}
                  <div class="post-card-body">
                    <p class="meta">{formatDate(post.data.publishedAt)}</p>
                    <h3>{post.data.title}</h3>
                    <p class="muted small">{post.data.description}</p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <section class="home-section" aria-labelledby="audience-title">
      <div class="wrap">
        <div class="home-head">
          <p class="home-eyebrow">{HOME.audience.eyebrow}</p>
          <h2 id="audience-title">{HOME.audience.title}</h2>
        </div>
        <div class="home-audience">
          {
            HOME.audience.cards.map(card => (
              <div class="home-audience-card">
                <h3>{card.title}</h3>
                <p>{withName(card.body, name)}</p>
                <a class="button ghost" href={card.href} data-astro-prefetch={card.href.startsWith('/events') ? undefined : ''}>{card.cta}</a>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="home-section" aria-labelledby="faq-title">
      <div class="wrap home-faq-grid">
        <div class="home-head">
          <p class="home-eyebrow">{HOME.faq.eyebrow}</p>
          <h2 id="faq-title">{HOME.faq.title}</h2>
        </div>
        <div class="home-faq">
          {
            HOME.faq.items.map(item => (
              <details>
                <summary>
                  {item.q}
                  <Icon name="plus" size={20} class="home-faq-icon" />
                </summary>
                <p>{item.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="home-section home-section-last" data-guest-only aria-labelledby="cta-title">
      <div class="wrap">
        <div class="home-cta">
          <div>
            <h2 id="cta-title" data-brand-text={HOME.cta.title}>{withName(HOME.cta.title, name)}</h2>
            <p>{HOME.cta.body}</p>
          </div>
          <div class="home-cta-actions">
            <a class="button home-button-lg home-cta-primary" href="/account/register/" data-astro-prefetch>{HOME.cta.primary}</a>
            <a class="button home-button-lg home-cta-ghost" href="/account/login/" data-astro-prefetch>{HOME.cta.secondary}</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
    import type {EventsPage} from '../lib/types';

  // Client navigation (ClientRouter): a bundled script runs once, so this page's code runs on
  // every `astro:page-load` (the first load, each navigation, back/forward) while it is this page.
  document.addEventListener('astro:page-load', () => {
    if (!document.querySelector('[data-live="events"]')) return;
    /** One element with text: never HTML from an answer. */
    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, className = '', text = '') => {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text) node.textContent = text;
      return node;
    };

    async function live<T>(name: string, path: string, render: (data: T, list: HTMLElement) => number) {
      const section = document.querySelector<HTMLElement>(`[data-live="${name}"]`);
      const list = section?.querySelector<HTMLElement>('[data-list]');
      if (!section || !list) return;
      try {
        const res = await fetch(path, {headers: {accept: 'application/json'}});
        if (!res.ok) return;
        if (render((await res.json()) as T, list) > 0) section.hidden = false;
      } catch {
        // The section stays hidden: the page is complete without it.
      }
    }

    void live<EventsPage>('events', '/site-api/events', (data, list) => {
      const shown = data.events.slice(0, 8);
      shown.forEach((event, i) => {
        let zone = 'UTC';
        try {
          new Intl.DateTimeFormat('en', {timeZone: event.timezone});
          zone = event.timezone;
        } catch {
          // Unknown zone: UTC.
        }
        const when = new Intl.DateTimeFormat('en', {weekday: 'short', day: 'numeric', month: 'short', timeZone: zone}).format(new Date(event.startAt));
        const art = el('div', 'home-event-art');
        art.dataset.pal = String(i % 4);
        art.append(el('span', 'home-event-date', when));
        if (event.coverImageUrl) {
          const img = el('img');
          img.src = event.coverImageUrl;
          img.alt = '';
          img.loading = 'lazy';
          art.append(img);
        } else {
          art.append(el('span', 'home-event-name', event.title));
        }
        const where = event.format === 'online' ? 'Online' : (event.venueName ?? (event.format === 'hybrid' ? 'Hybrid' : 'In person'));
        const price = event.fromPrice ? (event.free ? 'Free' : 'Tickets') : '';
        const text = el('div');
        text.append(el('h3', '', event.title), el('p', '', new Intl.DateTimeFormat('en', {hour: 'numeric', minute: '2-digit', timeZone: zone}).format(new Date(event.startAt)) + ' · ' + where), ...(price ? [el('p', '', price)] : []));
        const row = el('a', 'home-event');
        row.href = `/events/${encodeURIComponent(event.slug)}/`;
        row.append(art, text);
        const item = el('li');
        item.append(row);
        list.append(item);
      });
      return shown.length;
    });
  });
</script>
