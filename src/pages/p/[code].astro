---
/**
 * `/p/<code>`: the guest voting page, rendered on the server (the first state is read in-process
 * from `GET /site-api/polls-public/:code/active`) and kept live by `src/lib/poll-client.ts`.
 * A malformed or unknown code is a real 404. Never cached: it shows live data.
 * Look: the original app's VotePage, "the guest's phone in a dark room": one question per screen, 48px
 * pill targets, no login (the `.g-poll .poll-*` rules in `src/styles/public.css` dress the client's markup).
 */
import ErrorScreen from '../../components/ErrorScreen.astro';
import Base from '../../layouts/Base.astro';
import {jsonForScript, normalizeJoinCode} from '../../server/routes/polls-public';
import {app} from '../../server/app';
import {inProcessHeaders} from '../../server/privacy';
import {pageContext} from '../../server/page';

export const prerender = false;

const code = normalizeJoinCode(Astro.params.code ?? '');
const {site, viewer} = await pageContext(Astro.request, Astro.response);
let initial: unknown = null;
let missing = !code;
if (code) {
  const headers = inProcessHeaders(Astro.request, ['cookie']);
  const answer = await Promise.resolve(app.request(new URL(`/site-api/polls-public/${code}/active`, Astro.url.origin).toString(), {headers})).catch(() => null);
  if (answer?.ok) initial = await answer.json();
  else if (answer?.status === 404) missing = true;
}
if (missing) Astro.response.status = 404;
else if (!initial) {
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', '30');
}
const title = (initial as {event?: {title?: string}} | null)?.event?.title;
// JSON inside a <script> block: `<` is escaped so poll text can never close the tag.
const initialJson = jsonForScript(initial);
const clean = (code ?? '').toUpperCase().replace(/[\s-]/g, '');
const shownCode = clean.length === 6 ? `${clean.slice(0, 3)}-${clean.slice(3)}` : clean;
---

{
  missing ? (
    <Base site={site} viewer={viewer} title="Poll not found" noindex guest>
      <ErrorScreen poster={['No poll', 'with that code']} description="Check the code on the host's screen and try again." action={{href: '/', label: 'Go to the start'}} />
    </Base>
  ) : (
    <Base site={site} viewer={viewer} title={title ? `Vote: ${title}` : 'Live poll'} noindex guest>
      <main id="main" tabindex="-1" class="g-main">
        <div class="g-poll">
          <header class="g-poll-head">
            <p>{title ?? 'Live poll'}</p>
            <div class="g-poll-tags">
              <span class="g-poll-code type-code" aria-label={`Code ${clean.split('').join(' ')}`}>{shownCode}</span>
            </div>
          </header>
          <div id="poll-root" data-code={code}>
            <noscript>
              <p>Voting needs JavaScript.</p>
            </noscript>
          </div>
          {initial && <script id="poll-initial" type="application/json" set:html={initialJson} />}
          {!initial && <p class="g-notice g-notice-error" role="alert">We couldn't load the poll. Try again in a moment.</p>}
        </div>
      </main>
    </Base>
  )
}

<script>
  import {mountPoll} from '../../lib/poll-client';

  document.addEventListener('astro:page-load', () => {
    const root = document.getElementById('poll-root');
    if (root && !root.dataset.mounted) {
      root.dataset.mounted = '1';
      mountPoll(root);
    }
  });
</script>
