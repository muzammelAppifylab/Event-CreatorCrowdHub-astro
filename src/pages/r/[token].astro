---
/**
 * The guest's own page: confirmation AND manage (`/r/<token>`, the link in their email and where the
 * RSVP form sends them). The token is the credential: the page is never cached, never indexed and never
 * sent on as a Referer. A bad, rotated or expired token is a real 404 (indistinguishable on purpose).
 * A valid token whose event the host unpublished or deleted is a 410 "no longer available" page with
 * only the title and the guest's privacy links (Your data, Unsubscribe: audit M-23).
 * Look: the original app's ConfirmationPage (the mint "You're in" band for a confirmed Going guest,
 * a quiet banner for every other state) followed by its ManageRsvpPage (summary, event, edit, cancel).
 */
import {renderSVG} from 'uqr';

import ErrorScreen from '../../components/ErrorScreen.astro';
import GIcon from '../../components/GIcon.astro';
import {responseLabel, statusBadge, statusCopy} from '../../components/rsvp/copy';
import EventUnavailable from '../../components/rsvp/EventUnavailable.astro';
import RsvpForm from '../../components/rsvp/RsvpForm.astro';
import {rsvpReadOr410} from '../../components/rsvp/unavailable';
import Base from '../../layouts/Base.astro';
import {formatShortWhen, formatDay, formatRange, guestCopy, routeCopy} from '../../lib/guest-format';
import type {AnswerValue, GuestRsvpView} from '../../lib/rsvp-types';
import {app} from '../../server/app';
import {inProcessHeaders} from '../../server/privacy';
import {pageContext} from '../../server/page';

const token = Astro.params.token ?? '';
const [{site, viewer}, found] = await Promise.all([
  pageContext(Astro.request, Astro.response),
  rsvpReadOr410<GuestRsvpView>(Astro.request, `/manage/${encodeURIComponent(token)}`),
]);
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
Astro.response.headers.set('X-Robots-Tag', 'noindex');
// 410: a valid link whose event the host unpublished or deleted. Only its title, never the RSVP.
const {unavailable} = found;
const guest = found.data;
const missing = !guest && !unavailable && found.status === 404;
if (!guest) {
  Astro.response.status = unavailable ? 410 : missing ? 404 : 503;
  if (!unavailable && !missing) Astro.response.headers.set('Retry-After', '60');
}
const hostName = site?.name ?? 'The host';
const ticket = guest?.event.ticketTypes.find(t => t.id === guest.rsvp.ticketTypeId);
const paid = guest?.event.ticketTypes.some(t => t.priceCents > 0) ?? false;
const spec = guest
  ? statusCopy(guest.rsvp.status, guest.rsvp.response, {host: hostName, email: guest.rsvp.email, waitlistPosition: guest.rsvp.waitlistPosition, paid})
  : null;
const youreIn = spec?.youreIn ?? false;
const confirmed = !!guest && guest.rsvp.status === 'confirmed' && guest.rsvp.response !== 'not_going';
const saved = Astro.url.searchParams.get('saved') === '1';
const cancelledEvent = guest?.event.status === 'cancelled';
const active = !!guest && guest.rsvp.status !== 'cancelled' && guest.rsvp.status !== 'declined' && !cancelledEvent;
// Declined or cancelled: the same form re-opens this RSVP here (audit M-11). The event page's form
// can't: the email already has an RSVP, so it would only email a link back to this page.
const reopen = !!guest && !active && !cancelledEvent && guest.rsvp.canEdit && !guest.event.closed;
// A private event's page answers 404 without an invite (audit L-1): the server then points pageUrl at this
// page, and no link to the event page is shown.
const publicPage = guest && guest.event.pageUrl.includes('/events/') ? `/events/${guest.event.slug}/` : null;
// A waitlisted guest holds no seat: their cancel step says "leave the waitlist" (audit L-35).
const onWaitlist = guest?.rsvp.status === 'waitlisted';
const joinUrl = confirmed && guest && guest.event.format !== 'in_person' ? guest.event.joinUrl : null;
const showTicket = confirmed && !!guest?.rsvp.ticketCode && guest.event.format !== 'online';
const qr = guest && showTicket ? renderSVG(`${Astro.url.origin}/dashboard/checkin/code/${encodeURIComponent(guest.rsvp.ticketCode ?? '')}`, {border: 1}) : '';
// The live-poll link carries the manage token (`?g=`) so a non-anonymous poll can list this guest; the
// route answers only for a voting-eligible RSVP of a published event. This page is no-referrer.
let pollPath: string | null = null;
if (confirmed && token) {
  const hit = await Promise.resolve(app.request(new URL(`/site-api/polls-public/guest-link/${encodeURIComponent(token)}`, Astro.url.origin).toString(), {headers: inProcessHeaders(Astro.request, ['cookie'])})).catch(() => null);
  if (hit?.ok) pollPath = ((await hit.json().catch(() => null)) as {path?: string} | null)?.path ?? null;
}
const inPerson = guest ? guest.event.format !== 'online' : false;
const place = guest
  ? guest.event.format === 'online'
    ? guestCopy.format.online
    : [guest.event.venueName, guest.event.venueAddress].filter(Boolean).join(', ')
  : '';
const when = guest ? formatShortWhen(guest.event.startAt, guest.event.timezone) : '';
const formatAnswer = (value: AnswerValue | undefined) => {
  if (value === undefined) return 'No answer';
  if (typeof value === 'boolean') return value ? 'Yes' : 'No';
  if (Array.isArray(value)) return value.length ? value.join(', ') : 'No answer';
  return value.trim() || 'No answer';
};
const rsvpGone = routeCopy.rsvpNotFound;
const failed = routeCopy.loadFailed;
---

{
  guest && spec ? (
    <Base site={site} viewer={viewer} title={`Your RSVP: ${guest.event.title}`} noindex secretInUrl guest>
      <main id="main" tabindex="-1" class="g-main">
        <div class="g-flow">
          {
            youreIn ? (
              <section aria-labelledby="status-title" class="g-signal">
                <div class="page-container">
                  <div class="g-signal-text">
                    <h1 id="status-title" class="type-poster">
                      {guestCopy.confirmation.youreIn[0]}
                      <br />
                      {guestCopy.confirmation.youreIn[1]}
                    </h1>
                    <div class="g-signal-facts">
                      <p class="g-lead g-strong-inherit">{guest.event.title}</p>
                      <p class="g-strong-inherit" data-numeric>{when}</p>
                      {place && <p>{place}</p>}
                      <p>
                        {guestCopy.confirmation.seatsFor(guest.rsvp.name, guest.rsvp.plusOnes)} · {guestCopy.confirmation.seats(guest.rsvp.seats)}
                      </p>
                    </div>
                  </div>
                  <div class="g-signal-aside">
                    {showTicket && (
                      <section aria-labelledby="ticket-title" class="g-ticket">
                        <div class="g-ticket-top">
                          <div class="g-ticket-info">
                            <h2 id="ticket-title" class="g-ticket-kicker">Your ticket</h2>
                            {ticket && <p class="g-body-sm g-strong-inherit">{ticket.name}</p>}
                            <p class="g-body-sm">
                              {guestCopy.confirmation.seatsFor(guest.rsvp.name, guest.rsvp.plusOnes)} · {guestCopy.confirmation.seats(guest.rsvp.seats)}
                            </p>
                          </div>
                          <div class="g-ticket-qr" role="img" aria-label={`Ticket QR code for ${guest.rsvp.name}`} set:html={qr} />
                        </div>
                        <div class="g-ticket-bottom">
                          <p class="g-ticket-code">
                            <span class="g-ticket-kicker">Ticket code</span>
                            <span class="type-code">{guest.rsvp.ticketCode}</span>
                          </p>
                          <p class="g-caption">Show this at the door.</p>
                        </div>
                      </section>
                    )}
                    {active && (
                      <div class="g-btn-row">
                        <a class="g-btn g-btn-lg g-btn-ink" href={guest.calendar.icsPath} download data-astro-reload>
                          <GIcon name="calendar-plus" />
                          Download .ics
                        </a>
                        <a class="g-btn g-btn-lg g-btn-outline g-btn-signal-outline" href={guest.calendar.googleUrl} target="_blank" rel="noopener noreferrer">
                          Google Calendar
                          <GIcon name="external-link" />
                          <span class="sr-only">{guestCopy.location.opensNewTab}</span>
                        </a>
                      </div>
                    )}
                  </div>
                </div>
              </section>
            ) : (
              <section aria-labelledby="status-title" class="g-quiet">
                <div class="page-container">
                  <span class="g-quiet-icon" aria-hidden="true">
                    <GIcon name={spec.icon} class="g-icon-6" stroke={1.75} />
                  </span>
                  <span class={`g-badge g-badge-${spec.badge.tone}`}>
                    <span class="g-badge-dot" aria-hidden="true" />
                    {spec.badge.label}
                  </span>
                  <h1 id="status-title" class="type-display g-display g-display-fixed">{spec.title}</h1>
                  <p class="g-lead">{spec.body}</p>
                  {guest.rsvp.status === 'awaiting_payment' && (
                    <p class="g-body-sm g-muted">If you closed the payment page, check your email or ask the host for a new link.</p>
                  )}
                  {guest.rsvp.status === 'cancelled' && publicPage && (
                    <a class="g-btn g-btn-lg g-btn-outline" href={publicPage}>Back to the event</a>
                  )}
                </div>
              </section>
            )
          }

          <div class="page-container">
            <div class="g-page-narrow-lg">
              {saved && <p class="g-notice g-notice-ok" role="status">Changes saved</p>}
              {cancelledEvent && <p class="g-notice g-notice-error" role="alert">{guestCopy.cancelledBanner.title}. {guestCopy.cancelledBanner.body}</p>}

              {!youreIn && showTicket && (
                <section aria-labelledby="ticket-title" class="g-ticket">
                  <div class="g-ticket-top">
                    <div class="g-ticket-info">
                      <h2 id="ticket-title" class="g-ticket-kicker">Your ticket</h2>
                      {ticket && <p class="g-body-sm g-strong-inherit">{ticket.name}</p>}
                      <p class="g-body-sm">
                        {guestCopy.confirmation.seatsFor(guest.rsvp.name, guest.rsvp.plusOnes)} · {guestCopy.confirmation.seats(guest.rsvp.seats)}
                      </p>
                    </div>
                    <div class="g-ticket-qr" role="img" aria-label={`Ticket QR code for ${guest.rsvp.name}`} set:html={qr} />
                  </div>
                  <div class="g-ticket-bottom">
                    <p class="g-ticket-code">
                      <span class="g-ticket-kicker">Ticket code</span>
                      <span class="type-code">{guest.rsvp.ticketCode}</span>
                    </p>
                    <p class="g-caption">Show this at the door.</p>
                  </div>
                </section>
              )}

              {!youreIn && confirmed && active && (
                <section aria-labelledby="calendar-title" class="g-section">
                  <h2 id="calendar-title" class="g-title-sm">Add to your calendar</h2>
                  <div class="g-btn-row">
                    <a class="g-btn g-btn-lg" href={guest.calendar.icsPath} download data-astro-reload>
                      <GIcon name="calendar-plus" />
                      Download .ics
                    </a>
                    <a class="g-btn g-btn-lg g-btn-outline" href={guest.calendar.googleUrl} target="_blank" rel="noopener noreferrer">
                      Google Calendar
                      <GIcon name="external-link" />
                      <span class="sr-only">{guestCopy.location.opensNewTab}</span>
                    </a>
                  </div>
                </section>
              )}

              {joinUrl && (
                <div class="g-card">
                  <div class="g-card-body">
                    <div class="g-join">
                      <span class="g-fact-well" aria-hidden="true"><GIcon name="monitor-play" class="g-icon-5" stroke={1.75} /></span>
                      <div class="g-host-text">
                        <h2 class="g-title-sm">Your join link</h2>
                        <p class="g-body-sm g-join-url">{joinUrl}</p>
                        <p class="g-body-sm g-muted">Keep this to yourself. It's also in your confirmation email.</p>
                      </div>
                    </div>
                    <a class="g-btn g-btn-lg g-fit" href={joinUrl} target="_blank" rel="noopener noreferrer">
                      Join the event
                      <GIcon name="arrow-up-right" />
                      <span class="sr-only">{guestCopy.location.opensNewTab}</span>
                    </a>
                  </div>
                </div>
              )}

              {pollPath && (
                <div class="g-card">
                  <div class="g-card-body">
                    <h2 class="g-title-sm">Live poll</h2>
                    <p class="g-body-sm g-muted">Join the poll during the event.</p>
                    <a class="g-btn g-btn-lg g-fit" href={pollPath} data-astro-reload>Open the poll</a>
                  </div>
                </div>
              )}

              <section aria-labelledby="manage-summary">
                <div class="g-card">
                  <div class="g-card-body">
                    <h2 id="manage-summary" class="g-title-sm">Summary</h2>
                    <dl class="g-dl">
                      <dt>Status</dt>
                      <dd>
                        <span class={`g-badge g-badge-${statusBadge[guest.rsvp.status].tone}`}>
                          <span class="g-badge-dot" aria-hidden="true" />
                          {statusBadge[guest.rsvp.status].label}
                        </span>
                      </dd>
                      <dt>Response</dt>
                      <dd class="g-strong-inherit">{responseLabel[guest.rsvp.response]}</dd>
                      {guest.rsvp.response !== 'not_going' && (
                        <>
                          <dt>Seats</dt>
                          <dd data-numeric>
                            {guestCopy.confirmation.seatsFor(guest.rsvp.name, guest.rsvp.plusOnes)} · {guestCopy.confirmation.seats(guest.rsvp.seats)}
                          </dd>
                        </>
                      )}
                      {ticket && (
                        <>
                          <dt>Ticket</dt>
                          <dd>
                            {ticket.name}
                            {guest.rsvp.ticketCode && (
                              <>
                                {' · '}
                                <span class="type-code">{guest.rsvp.ticketCode}</span>
                              </>
                            )}
                          </dd>
                        </>
                      )}
                    </dl>
                    {guest.event.questions.length > 0 && (
                      <div class="g-answers-box">
                        <h3>Your answers</h3>
                        <dl class="g-answers">
                          {guest.event.questions.map(q => (
                            <div>
                              <dt>{q.label}</dt>
                              <dd>{formatAnswer(guest.rsvp.answers[q.id])}</dd>
                            </div>
                          ))}
                        </dl>
                      </div>
                    )}
                  </div>
                </div>
              </section>

              <div class="g-card">
                <div class="g-card-body">
                  <h2 id="event-summary-title" class="g-title-sm">{guest.event.title}</h2>
                  <time class="g-when g-summary-time" datetime={guest.event.startAt} data-numeric>
                    <span class="g-strong-inherit">{formatDay(guest.event.startAt, guest.event.timezone)}</span>
                    <span>{formatRange(guest.event.startAt, guest.event.endAt, guest.event.timezone)}</span>
                  </time>
                  <div class="g-summary-line">
                    <GIcon name={inPerson ? 'map-pin' : 'monitor-play'} />
                    <span>
                      {inPerson && guest.event.venueName && <span class="g-strong-inherit">{guest.event.venueName}</span>}
                      {inPerson && guest.event.venueAddress && <span class="g-muted">{guest.event.venueAddress}</span>}
                      {guest.event.format !== 'in_person' && <span>{guestCopy.format[guest.event.format]}</span>}
                    </span>
                  </div>
                  <p class="g-body-sm g-muted">
                    {guestCopy.hero.hostedBy} <span class="g-strong-inherit g-fg">{hostName}</span>
                  </p>
                  <div class="g-btn-row-wrap">
                    {publicPage && (
                      <a class="g-btn g-btn-outline g-btn-lg" href={publicPage}>
                        View event page
                        <GIcon name="arrow-right" />
                      </a>
                    )}
                    {guest.event.mapUrl && inPerson && (
                      <a class="g-btn g-btn-ghost g-btn-lg" href={guest.event.mapUrl} rel="noopener noreferrer" target="_blank">
                        {guestCopy.location.openMap}
                        <GIcon name="arrow-up-right" />
                        <span class="sr-only">{guestCopy.location.opensNewTab}</span>
                      </a>
                    )}
                  </div>
                </div>
              </div>

              {
                guest.rsvp.canEdit && !guest.event.closed && active ? (
                  <>
                    <section class="g-section-rule" aria-labelledby="change-heading">
                      <h2 id="change-heading" class="g-title-sm">Change your answers</h2>
                      <RsvpForm
                        view={guest.event}
                        mode="edit"
                        token={token}
                        hostName={hostName}
                        values={{
                          name: guest.rsvp.name,
                          email: guest.rsvp.email,
                          response: guest.rsvp.response,
                          plusOnes: guest.rsvp.plusOnes,
                          ticketTypeId: guest.rsvp.ticketTypeId,
                          marketingConsent: guest.rsvp.marketingConsent,
                          answers: guest.rsvp.answers,
                        }}
                      />
                    </section>

                    <section class="g-section-rule" aria-labelledby="manage-cancel" data-cancel-root data-token={token}>
                      <h2 id="manage-cancel" class="g-title-sm">{onWaitlist ? 'No longer want a spot?' : "Can't make it after all?"}</h2>
                      <p class="g-body-sm g-muted g-prose-max">
                        {onWaitlist ? (
                          'Leaving the waitlist gives up your place in line. You can RSVP again later, but you join at the back.'
                        ) : (
                          <>
                            This frees your {guest.rsvp.seats === 1 ? 'seat' : `${guest.rsvp.seats} seats`} for someone else, and the next person on the waitlist gets it. You can RSVP again later if spaces remain.
                            {paid && ' For a refund on a paid ticket, contact the host.'}
                          </>
                        )}
                      </p>
                      <button class="g-btn g-btn-outline g-btn-lg" type="button" data-cancel-open>{onWaitlist ? 'Leave the waitlist' : 'Cancel my RSVP'}</button>
                      <div class="g-cancel-panel" data-cancel-confirm hidden>
                        <h3 class="g-title-sm" tabindex="-1" data-cancel-heading>{onWaitlist ? 'Leave the waitlist?' : 'Cancel your RSVP?'}</h3>
                        <p class="g-body-sm g-muted">{onWaitlist ? 'You lose your place in line.' : 'Your seat is released.'}</p>
                        <p class="g-notice g-notice-error" data-cancel-status hidden role="alert"></p>
                        <div class="g-btn-row">
                          <button class="g-btn g-btn-lg g-btn-destructive" type="button" data-cancel-yes data-pending={onWaitlist ? 'Leaving…' : 'Cancelling…'}>{onWaitlist ? 'Yes, leave the waitlist' : 'Yes, cancel my RSVP'}</button>
                          <button class="g-btn g-btn-lg g-btn-outline" type="button" data-cancel-no>{onWaitlist ? 'Stay on the waitlist' : 'Keep my RSVP'}</button>
                        </div>
                      </div>
                    </section>
                  </>
                ) : guest.rsvp.canEdit && !cancelledEvent && active ? (
                  <p class="g-body-sm g-muted">RSVPs for this event have closed, so changes are no longer accepted here.</p>
                ) : reopen ? (
                  <section class="g-section-rule" aria-labelledby="again-heading">
                    <h2 id="again-heading" class="g-title-sm">RSVP again</h2>
                    <p class="g-body-sm g-muted g-prose-max">Changed your mind? Send a new reply below. Seats go to whoever answers first.</p>
                    <RsvpForm
                      view={guest.event}
                      mode="edit"
                      token={token}
                      hostName={hostName}
                      values={{
                        name: guest.rsvp.name,
                        email: guest.rsvp.email,
                        response: 'going',
                        plusOnes: guest.rsvp.plusOnes,
                        ticketTypeId: guest.rsvp.ticketTypeId,
                        marketingConsent: guest.rsvp.marketingConsent,
                        answers: guest.rsvp.answers,
                      }}
                    />
                  </section>
                ) : !active && !cancelledEvent && !guest.event.closed && publicPage ? (
                  <a class="g-btn g-btn-lg g-fit" href={publicPage}>
                    RSVP again
                    <GIcon name="arrow-right" />
                  </a>
                ) : null
              }
              <nav class="g-section-rule g-btn-row-wrap g-body-sm" aria-label="Your data">
                <a href={`/privacy/guest/${encodeURIComponent(token)}/`}>Your data</a>
                <a href={`/privacy/unsubscribe/${encodeURIComponent(token)}/`}>Unsubscribe</a>
              </nav>
            </div>
          </div>
        </div>
      </main>
    </Base>
  ) : unavailable ? (
    <Base site={site} viewer={viewer} title="Event no longer available" noindex secretInUrl guest>
      <EventUnavailable title={unavailable.event.title} privacyToken={token} />
    </Base>
  ) : missing ? (
    <Base site={site} viewer={viewer} title="Link not found" noindex guest>
      <ErrorScreen poster={rsvpGone.poster} description={rsvpGone.body} action={{href: '/', label: rsvpGone.action}} />
    </Base>
  ) : (
    <Base site={site} viewer={viewer} title="Not available right now" noindex guest>
      <ErrorScreen poster={failed.poster} description={failed.body} action={{href: `/r/${encodeURIComponent(token)}/`, label: failed.action, prefetch: false, reload: true}} />
    </Base>
  )
}

<script>
  import {siteFetch} from '../../platform/browser';

  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('[data-cancel-root]');
    if (!root || root.dataset.bound) return;
    root.dataset.bound = '1';
    const open = root.querySelector<HTMLButtonElement>('[data-cancel-open]')!;
    const panel = root.querySelector<HTMLElement>('[data-cancel-confirm]')!;
    const yes = root.querySelector<HTMLButtonElement>('[data-cancel-yes]')!;
    const no = root.querySelector<HTMLButtonElement>('[data-cancel-no]')!;
    const status = root.querySelector<HTMLElement>('[data-cancel-status]')!;
    const idle = yes.textContent ?? '';

    open.addEventListener('click', () => {
      panel.hidden = false;
      open.hidden = true;
      // The question first, not the destructive button: an Enter press must not cancel by accident.
      root.querySelector<HTMLElement>('[data-cancel-heading]')?.focus();
    });
    no.addEventListener('click', () => {
      panel.hidden = true;
      open.hidden = false;
      status.hidden = true;
      open.focus();
    });
    yes.addEventListener('click', async () => {
      if (yes.disabled) return;
      yes.disabled = true;
      no.disabled = true;
      yes.setAttribute('aria-busy', 'true');
      yes.textContent = yes.dataset.pending ?? 'Cancelling…';
      status.hidden = true;
      try {
        const res = await siteFetch(`/site-api/rsvp/manage/${root.dataset.token}/cancel`, {method: 'POST'});
        if (res.ok) {
          // Keep the button pending: the refreshed page is on its way.
          window.location.assign(window.location.pathname);
          return;
        }
        const data = (await res.json().catch(() => null)) as {message?: string} | null;
        status.textContent = data?.message ?? `Something went wrong (${res.status}). Try again.`;
      } catch {
        status.textContent = 'The site did not answer. Check your connection and try again.';
      }
      status.hidden = false;
      yes.disabled = false;
      no.disabled = false;
      yes.removeAttribute('aria-busy');
      yes.textContent = idle;
    });
  });
</script>
