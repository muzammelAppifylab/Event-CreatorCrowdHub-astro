---
/**
 * One event, rendered on the server from `GET /site-api/events/:slug`. Unknown or unpublished
 * answers a real 404; a database outage a 503. The RSVP form (free tickets; paid tickets hook into `src/server/routes/rsvp.ts`) comes from
 * `GET /site-api/rsvp/events/:slug`; if that route is not mounted yet the page simply has no form.
 * The look is the original app's guest event page (`src/components/EventView.astro`).
 */
import ErrorScreen from '../../components/ErrorScreen.astro';
import EventView from '../../components/EventView.astro';
import {copy} from '../../config/copy';
import Base from '../../layouts/Base.astro';
import {descriptionExcerpt} from '../../domain/richText';
import {routeCopy} from '../../lib/guest-format';
import {eventJsonLd} from '../../lib/seo';
import type {EventDetail} from '../../lib/types';
import {backend, read} from '../../server/backend';
import {rsvpRead} from '../../components/rsvp/server';
import type {RsvpEventView} from '../../lib/rsvp-types';
import {pageContext} from '../../server/page';

const slug = Astro.params.slug ?? '';
const [{site, viewer}, answer] = await Promise.all([
  pageContext(Astro.request, Astro.response),
  backend(Astro.request)
    .events[':slug'].$get({param: {slug}})
    .catch(() => null),
]);
const found = answer?.ok ? await read<{event: EventDetail}>(Promise.resolve(answer)) : null;
const event = found?.event ?? null;
const missing = !event && answer?.status === 404;
if (!event) {
  Astro.response.status = missing ? 404 : 503;
  if (!missing) Astro.response.headers.set('Retry-After', '60');
}
const rsvp = event ? (await rsvpRead<{event: RsvpEventView}>(Astro.request, `/events/${encodeURIComponent(slug)}`)).data?.event ?? null : null;
const failed = routeCopy.loadFailed;
const gone = copy.errors.eventNotFound;
---

{
  event ? (
    <Base site={site} viewer={viewer} guest noindex={event.visibility !== 'public'} title={event.title} description={descriptionExcerpt(event.description) || event.title} jsonLd={eventJsonLd(event, site ?? undefined)}>
      <main id="main" tabindex="-1" class="g-main" data-event-slug={event.slug}>
        <EventView event={event} rsvp={rsvp} site={site} />
      </main>
    </Base>
  ) : missing ? (
    <Base site={site} viewer={viewer} title="Event not found" noindex guest>
      <ErrorScreen poster={gone.poster} description={gone.body} action={{href: '/events/', label: gone.action}} />
    </Base>
  ) : (
    <Base site={site} viewer={viewer} title="Not available right now" noindex guest>
      <ErrorScreen poster={failed.poster} description={failed.body} action={{href: `/events/${encodeURIComponent(slug)}/`, label: failed.action, prefetch: false, reload: true}} />
    </Base>
  )
}

<script>
  import {siteFetch} from '../../platform/browser';

  // One anonymous page view per visit (the server dedupes per visitor and day; always 204).
  document.addEventListener('astro:page-load', () => {
    const slug = document.querySelector<HTMLElement>('[data-event-slug]')?.dataset.eventSlug;
    if (!slug) return;
    const utmSource = new URLSearchParams(location.search).get('utm_source');
    void siteFetch(`/site-api/pageviews/${encodeURIComponent(slug)}`, {
      method: 'POST',
      headers: {'content-type': 'application/json'},
      body: JSON.stringify({utmSource}),
    }).catch(() => {});
  });
</script>
