---
/**
 * `/privacy/unsubscribe/<token>`: the unsubscribe link in every guest email (the RSVP's manage token,
 * or a signed unsubscribe token from a reminder or broadcast). Rendered on
 * request, never indexed, never cached. Opening the page changes nothing; the button POSTs to
 * `/site-api/privacy/unsubscribe/:token`.
 */
import Base from '../../../layouts/Base.astro';
import type {ConsentState} from '../../../lib/privacy-types';
import {app} from '../../../server/app';
import {inProcessHeaders} from '../../../server/privacy';
import {pageContext} from '../../../server/page';

export const prerender = false;

const token = Astro.params.token ?? '';
const [{site, viewer}, res] = await Promise.all([
  pageContext(Astro.request, Astro.response),
  Promise.resolve(app.request(`/site-api/privacy/unsubscribe/${encodeURIComponent(token)}`, {headers: inProcessHeaders(Astro.request)})).catch(() => null),
]);
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
const info = res?.ok ? ((await res.json().catch(() => null)) as ConsentState | null) : null;
const invalid = !info;
if (invalid) Astro.response.status = res && res.status !== 404 ? 503 : 404;
---

<Base site={site} viewer={viewer} title="Unsubscribe" noindex guest secretInUrl>
  <main id="main" tabindex="-1" class="g-main">
    <div class="page-container g-doc">
      {
        invalid ? (
          <>
            <h1>This link is not valid</h1>
            <p class="muted">It may have been replaced by a newer one. Use the link in your latest email from the host.</p>
          </>
        ) : info.state === 'off' ? (
          <>
            <h1>You are unsubscribed</h1>
            <p class="muted">You will not get marketing updates or announcements from the host of {info.event.title}. Emails about your RSVP itself (confirmation, reminders) still arrive.</p>
          </>
        ) : (
          <>
            <h1>Unsubscribe from updates</h1>
            <p class="muted">Stop marketing updates and announcements from the host of {info.event.title}, for every event you RSVP'd to with this address. Emails about your RSVP itself (confirmation, reminders) still arrive.</p>
            <form id="unsubscribe-form" class="g-form" novalidate data-token={token}>
              <p class="notice" data-form-status hidden />
              <button class="g-btn g-btn-lg" type="submit">Unsubscribe</button>
            </form>
          </>
        )
      }
      <p class="g-body-sm g-doc-link"><a href="/privacy/">How we handle your data</a></p>
    </div>
  </main>
</Base>

<script>
  import {replaceWithMessage} from '../../../lib/account';
  import {bindForm, postJson} from '../../../lib/form';
  import {siteFetch} from '../../../platform/browser';

  document.addEventListener('astro:page-load', () => {
    const form = document.querySelector<HTMLFormElement>('#unsubscribe-form');
    if (!form) return;
    const token = form.dataset.token ?? '';
    bindForm(form, {
      rules: {},
      pendingLabel: 'Unsubscribing…',
      async submit() {
        const {result} = await postJson(siteFetch, `/site-api/privacy/unsubscribe/${encodeURIComponent(token)}`, {});
        if (result.ok) replaceWithMessage(form, result.message ?? 'You are unsubscribed.');
        return result;
      },
    });
  });
</script>
