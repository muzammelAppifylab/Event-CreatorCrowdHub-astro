// The Site Database's schema (Prisma ORM 7). Change it, then run
// `npx prisma migrate dev --create-only --name <what-changed>` against the
// Preview Database, wrap the new migration.sql in BEGIN; … COMMIT;, apply it
// with `npx prisma migrate dev`, then `npx prisma generate` (docs/agent/database.md).
//
// Tables marked MANAGED belong to the template's auth core (src/platform/auth):
// add columns to them only through a template upgrade.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // The client runs in the Cloudflare Workers runtime, never in Node.
  runtime  = "workerd"
  previewFeatures = ["partialIndexes"]
}

// TESTS ONLY: the same client for Node, so `npm test` can run the real Site API
// against a real Postgres (vitest aliases the import to it). Never imported by
// site code; git-ignored like the one above.
generator nodeClient {
  provider = "prisma-client"
  output   = "../src/generated/prisma-node"
  runtime  = "nodejs"
  previewFeatures = ["partialIndexes"]
}

// The connection string is NOT here: prisma.config.ts reads DATABASE_URL from
// the environment, which the platform sets (the Build never gets one).
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- auth (MANAGED)

/// A person with an account on this site. `email` is stored trimmed and
/// lower-cased. Only the user and holders of `site:user:read` ever see it.
model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique @db.VarChar(254)
  /// `pbkdf2-sha256$v1$<iterations>$<salt>$<key>` (src/platform/auth/password.ts).
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  name            String    @db.VarChar(80)
  /// `active` or `suspended`.
  status          String    @default("active") @db.VarChar(16)
  emailVerifiedAt DateTime? @map("email_verified_at")
  /// Bumped on password change, logout-all and suspension: every access token
  /// carrying an older value stops working at once.
  sessionVersion  Int       @default(1) @map("session_version")
  lastLoginAt     DateTime? @map("last_login_at")
  /// Two-step sign-in (src/platform/auth/two-factor.ts): the authenticator secret, SEALED
  /// (never in clear), set once the user confirmed a first code (`totpEnabledAt`).
  totpSecretSealed  String?   @map("totp_secret_sealed") @db.VarChar(255)
  /// A secret shown during setup, not yet confirmed with a code.
  totpPendingSealed String?   @map("totp_pending_sealed") @db.VarChar(255)
  totpEnabledAt     DateTime? @map("totp_enabled_at")
  /// The 30-second step of the last accepted code: that code (and older) never works again.
  totpLastStep      Int?      @map("totp_last_step")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  roles              UserRole[]
  refreshTokens      RefreshToken[]
  passwordResets     PasswordReset[]
  emailVerifications EmailVerification[]
  emailChanges       EmailChange[]
  recoveryCodes      RecoveryCode[]
  signInCodes        SignInCode[]

  @@index([status, id])
  @@map("users")
}

/// A role: a named set of permissions. `is_system` roles (owner, admin,
/// member) are seeded and cannot be deleted; `owner` cannot be edited.
model Role {
  id          Int      @id @default(autoincrement())
  slug        String   @unique @db.VarChar(48)
  name        String   @db.VarChar(80)
  description String?  @db.VarChar(255)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

/// The permission catalogue: one row per codename (`site:job:manage`,
/// `site:user:*`, `*`). Shipped as idempotent migrations, matched by codename.
model Permission {
  id          Int      @id @default(autoincrement())
  codename    String   @unique @db.VarChar(128)
  title       String   @db.VarChar(120)
  description String?  @db.VarChar(255)
  /// Groups the catalogue in the roles screen ("Users", "Jobs").
  groupName   String   @default("General") @map("group_name") @db.VarChar(48)
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int      @map("role_id")
  permissionId Int      @map("permission_id")
  grantedBy    Int?     @map("granted_by")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    Int      @map("user_id")
  roleId    Int      @map("role_id")
  grantedBy Int?     @map("granted_by")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId, userId])
  @@map("user_roles")
}

/// One refresh token, stored only as its SHA-256. Tokens of one sign-in share
/// a `family_id`; each rotation marks the old row used and points the new
/// row at it (`rotated_from`). Reuse of a used token revokes the family.
model RefreshToken {
  id                BigInt    @id @default(autoincrement())
  familyId          String    @map("family_id") @db.Uuid
  userId            Int       @map("user_id")
  tokenHash         String    @unique @map("token_hash") @db.Char(64)
  rotatedFromId     BigInt?   @map("rotated_from")
  usedAt            DateTime? @map("used_at")
  revokedAt         DateTime? @map("revoked_at")
  revokedReason     String?   @map("revoked_reason") @db.VarChar(16)
  expiresAt         DateTime  @map("expires_at")
  absoluteExpiresAt DateTime  @map("absolute_expires_at")
  userAgent         String?   @map("user_agent") @db.VarChar(255)
  ipHash            String?   @map("ip_hash") @db.Char(64)
  createdAt         DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// A single-use password reset link (30 minutes), stored as its SHA-256.
model PasswordReset {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  ipHash    String?   @map("ip_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("password_resets")
}

/// A single-use email confirmation link (24 hours), stored as its SHA-256.
model EmailVerification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  /// The address this link confirms (the user's email when it was sent).
  email     String    @db.VarChar(254)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("email_verifications")
}

/// A 6-digit sign-in code emailed to the account (src/platform/auth/code-routes.ts): 10 minutes,
/// single use, 5 wrong tries and it is spent. Only its keyed hash is stored. A new code ends the
/// older ones.
model SignInCode {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  codeHash  String    @map("code_hash") @db.Char(64)
  tries     Int       @default(0)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  ipHash    String?   @map("ip_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("sign_in_codes")
}

/// Rate-limit ledger: one row per attempt. Keyed hashes only (never the raw
/// email or IP). Rows older than a day are swept on the way.
model LoginAttempt {
  id        BigInt   @id @default(autoincrement())
  /// `login`, `register`, `reset`, `verify`, `password`, `code`, `codecheck`, ….
  kind      String   @db.VarChar(16)
  emailHash String?  @map("email_hash") @db.Char(64)
  ipHash    String   @map("ip_hash") @db.Char(64)
  succeeded Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([kind, emailHash, createdAt])
  @@index([kind, ipHash, createdAt])
  @@index([createdAt])
  @@map("login_attempts")
}

/// Security-relevant events (sign-ups, password changes, role changes,
/// refresh-token reuse). No email addresses, no raw IPs, no secrets.
/// A pending move of an account to a new address: the link mailed to the NEW address
/// (`/account/confirm-email/?token=…`) finishes it; single use, 24 hours.
model EmailChange {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  newEmail  String    @map("new_email") @db.VarChar(254)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("email_changes")
}

/// Two-step sign-in recovery codes, as SHA-256 hashes; each works once.
model RecoveryCode {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  codeHash  String    @map("code_hash") @db.Char(64)
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("recovery_codes")
}

model AuditEvent {
  id          BigInt   @id @default(autoincrement())
  actorUserId Int?     @map("actor_user_id")
  action      String   @db.VarChar(64)
  targetType  String?  @map("target_type") @db.VarChar(32)
  targetId    String?  @map("target_id") @db.VarChar(64)
  ipHash      String?  @map("ip_hash") @db.Char(64)
  /// Small, non-personal details (`{"roles":["admin"]}`). Never filtered on.
  meta        Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([actorUserId, id])
  @@index([targetType, targetId, id])
  @@map("audit_events")
}

/// One row (`id = 1`): who claimed the owner role first. Claimed with a
/// conditional update, so two simultaneous sign-ups can never both become owner.
model AuthState {
  id          Int      @id
  ownerUserId Int?     @map("owner_user_id")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("auth_state")
}

/// Background job deliveries already taken (`src/platform/background.ts`): the
/// replay guard for signed deliveries, across every Worker instance. One row
/// per job try; rows older than a day are swept on the way.
model JobDelivery {
  jobId   String   @map("job_id")
  attempt Int
  seenAt  DateTime @default(now()) @map("seen_at")

  @@id([jobId, attempt])
  @@index([seenAt])
  @@map("job_deliveries")
}

// ---------------------------------------------------------------- payments (MANAGED)
// Filled by src/server/payments-hooks.ts from the platform's payment events (and the thanks
// page's confirm). Add columns only through a template upgrade; keep your own data in your own
// tables, pointing at `checkout_id` / `subscription_id`.

/// Payment events already handled, by event id (`src/platform/payments.ts`): a retried or
/// replayed event runs its hook once. Rows older than 90 days are swept on the way.
model PaymentEvent {
  id         String   @id @db.VarChar(128)
  type       String   @db.VarChar(40)
  receivedAt DateTime @default(now()) @map("received_at")

  @@index([receivedAt])
  @@map("payment_events")
}

/// One paid (or failed / refunded) checkout. `checkout_id` is the platform's `pcs_…`.
model Order {
  id          Int       @id @default(autoincrement())
  checkoutId  String    @unique @map("checkout_id") @db.VarChar(80)
  priceKey    String    @map("price_key") @db.VarChar(63)
  /// `test` (sandbox) or `live`.
  mode        String    @default("test") @db.VarChar(4)
  email       String?   @db.VarChar(254)
  /// The signed-in buyer (`users.id`), from the checkout's `customerRef`. No foreign key: an
  /// order outlives a deleted account.
  userId      Int?      @map("user_id")
  /// `paid`, `failed`, `refunded` or `partially_refunded`.
  status      String    @db.VarChar(20)
  quantity    Int       @default(1)
  amountCents Int       @map("amount_cents")
  currency    String    @db.Char(3)
  metadata    Json?
  paidAt      DateTime? @map("paid_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([userId, id])
  @@index([email, id])
  @@map("orders")
}

/// A subscription bought on this site. Access: `active`, `trialing`, `past_due`, or `canceled`
/// until `access_ends_at` (`grantsAccess` in src/platform/payments.ts).
model Membership {
  id               Int       @id @default(autoincrement())
  subscriptionId   String    @unique @map("subscription_id") @db.VarChar(128)
  priceKey         String    @map("price_key") @db.VarChar(63)
  mode             String    @default("test") @db.VarChar(4)
  email            String?   @db.VarChar(254)
  userId           Int?      @map("user_id")
  status           String    @db.VarChar(20)
  currentPeriodEnd DateTime? @map("current_period_end")
  accessEndsAt     DateTime? @map("access_ends_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([userId, priceKey])
  @@index([email, priceKey])
  @@map("memberships")
}

// ---------------------------------------------------------------- the site's own data

/// A job on the job board (`/jobs`, `/jobs/<slug>`). Holders of
/// `site:job:manage` post and edit them from `/portal/jobs`.
model Job {
  id          Int      @id @default(autoincrement())
  /// URL name, unique: `/jobs/<slug>`.
  slug        String   @unique @db.VarChar(120)
  title       String   @db.VarChar(120)
  company     String   @db.VarChar(80)
  location    String   @db.VarChar(80)
  /// `full-time`, `part-time`, `contract` or `internship`.
  type        String   @default("full-time") @db.VarChar(20)
  remote      Boolean  @default(false)
  /// Plain text; paragraphs separated by blank lines.
  description String   @db.VarChar(10000)
  /// Where to apply: an https URL or a mailto: link the poster chose to publish.
  applyUrl    String   @map("apply_url") @db.VarChar(500)
  /// `open` (listed) or `closed` (kept, not listed).
  status      String   @default("open") @db.VarChar(10)
  /// The user (`users.id`) who posted it. No foreign key: a job outlives its poster.
  createdBy   Int      @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status, id])
  @@map("jobs")
}

// ---------------------------------------------------------------- events (ported from CreatorCrowdHub)

model Event {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug             String          @unique(map: "events_slug_live_uq", where: raw("(deleted_at IS NULL)"))
  title            String
  description      String          @default("")
  coverImageUrl    String?         @map("cover_image_url")
  startAt          DateTime        @map("start_at") @db.Timestamptz(6)
  endAt            DateTime        @map("end_at") @db.Timestamptz(6)
  timezone         String
  format           EventFormat
  venueName        String?         @map("venue_name")
  venueAddress     String?         @map("venue_address")
  mapUrl           String?         @map("map_url")
  joinUrl          String?         @map("join_url")
  visibility       EventVisibility @default(public)
  status           EventStatus     @default(draft)
  capacity         Int?
  rsvpDeadline     DateTime?       @map("rsvp_deadline") @db.Timestamptz(6)
  waitlistEnabled  Boolean         @default(true) @map("waitlist_enabled")
  approvalRequired Boolean         @default(false) @map("approval_required")
  allowMaybe       Boolean         @default(true) @map("allow_maybe")
  maxPlusOnes      Int             @default(0) @map("max_plus_ones") @db.SmallInt
  showGuestList    Boolean         @default(false) @map("show_guest_list")
  pollJoinCode     String          @unique(map: "events_poll_join_code_uq") @map("poll_join_code") @db.VarChar(6)
  thankYouLink     String?         @map("thank_you_link")
  deletedAt        DateTime?       @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  coverPoster      String?         @map("cover_poster")
  coverStyle       Json?           @map("cover_style")
  invites          Invite[]
  messages         Message[]
  pageViews        PageView[]
  polls            Poll[]
  reminderRules    ReminderRule[]
  rsvpQuestions    RsvpQuestion[]
  rsvps            Rsvp[]
  ticketTypes      TicketType[]

  @@index([startAt], map: "events_published_start_idx", where: raw("((status = 'published'::event_status) AND (deleted_at IS NULL))"))
  @@map("events")
}

model Invite {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId           String            @map("event_id") @db.Uuid
  email             String
  name              String?
  token             String            @unique(map: "invites_token_uq")
  status            InviteStatus      @default(queued)
  sentAt            DateTime?         @map("sent_at") @db.Timestamptz(6)
  lastResentAt      DateTime?         @map("last_resent_at") @db.Timestamptz(6)
  event             Event             @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "invites_event_id_events_id_fk")
  messageDeliveries MessageDelivery[]
  rsvps             Rsvp[]

  @@unique([eventId, email], map: "invites_event_email_uq")
  @@map("invites")
}

model MessageDelivery {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rsvpId         String?        @map("rsvp_id") @db.Uuid
  inviteId       String?        @map("invite_id") @db.Uuid
  reminderRuleId String?        @map("reminder_rule_id") @db.Uuid
  messageId      String?        @map("message_id") @db.Uuid
  channel        String         @default("email")
  status         DeliveryStatus @default(queued)
  sentAt         DateTime?      @map("sent_at") @db.Timestamptz(6)
  error          String?
  invite         Invite?        @relation(fields: [inviteId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "message_deliveries_invite_id_invites_id_fk")
  message        Message?       @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "message_deliveries_message_id_messages_id_fk")
  reminderRule   ReminderRule?  @relation(fields: [reminderRuleId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "message_deliveries_reminder_rule_id_reminder_rules_id_fk")
  rsvp           Rsvp?          @relation(fields: [rsvpId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "message_deliveries_rsvp_id_rsvps_id_fk")

  @@unique([rsvpId, reminderRuleId], map: "message_deliveries_rsvp_rule_uq")
  @@index([inviteId], map: "message_deliveries_invite_idx")
  @@index([messageId], map: "message_deliveries_message_idx")
  @@index([reminderRuleId], map: "message_deliveries_rule_idx")
  @@index([status])
  @@map("message_deliveries")
}

model Message {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId           String            @map("event_id") @db.Uuid
  segment           Segment
  subject           String
  body              String
  sentCount         Int               @default(0) @map("sent_count")
  sentBy            Int?              @map("sent_by")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  idempotencyKey    String?           @map("idempotency_key")
  messageDeliveries MessageDelivery[]
  event             Event             @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "messages_event_id_events_id_fk")

  @@unique([eventId, idempotencyKey], map: "messages_event_idempotency_uq")
  @@index([eventId], map: "messages_event_idx")
  @@index([sentBy])
  @@map("messages")
}

model PageView {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  visitorHash String   @map("visitor_hash")
  utmSource   String?  @map("utm_source")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  day         DateTime @default(dbgenerated("((now() AT TIME ZONE 'utc'::text))::date")) @db.Date
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "page_views_event_id_events_id_fk")

  @@unique([eventId, visitorHash, day], map: "page_views_event_visitor_day_uq")
  @@index([eventId, createdAt], map: "page_views_event_created_idx")
  @@map("page_views")
}

model PollOption {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pollId    String @map("poll_id") @db.Uuid
  label     String
  poll      Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "poll_options_poll_id_polls_id_fk")

  @@index([pollId], map: "poll_options_poll_idx")
  @@map("poll_options")
}

model PollVote {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pollId      String   @map("poll_id") @db.Uuid
  voterToken  String   @map("voter_token") @db.Uuid
  rsvpId      String?  @map("rsvp_id") @db.Uuid
  optionIds   Json     @default("[]") @map("option_ids")
  ratingValue Int?     @map("rating_value") @db.SmallInt
  textValue   String?  @map("text_value") @db.VarChar(140)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  poll        Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "poll_votes_poll_id_polls_id_fk")
  rsvp        Rsvp?    @relation(fields: [rsvpId], references: [id], onUpdate: NoAction, map: "poll_votes_rsvp_id_rsvps_id_fk")

  @@unique([pollId, voterToken], map: "poll_votes_poll_voter_uq")
  @@index([rsvpId], map: "poll_votes_rsvp_idx")
  @@map("poll_votes")
}

model Poll {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId             String       @unique(map: "polls_one_open_per_event_uq", where: raw("(status = 'open'::poll_status)")) @map("event_id") @db.Uuid
  question            String
  type                PollType
  status              PollStatus   @default(draft)
  anonymous           Boolean      @default(true)
  showResultsToVoters Boolean      @default(true) @map("show_results_to_voters")
  openedAt            DateTime?    @map("opened_at") @db.Timestamptz(6)
  closedAt            DateTime?    @map("closed_at") @db.Timestamptz(6)
  pollOptions         PollOption[]
  pollVotes           PollVote[]
  event               Event        @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "polls_event_id_events_id_fk")

  @@map("polls")
}

model ReminderRule {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId           String            @map("event_id") @db.Uuid
  kind              ReminderKind
  offsetMinutes     Int               @default(0) @map("offset_minutes")
  enabled           Boolean           @default(true)
  subject           String
  body              String
  messageDeliveries MessageDelivery[]
  event             Event             @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "reminder_rules_event_id_events_id_fk")

  @@index([eventId], map: "reminder_rules_event_idx")
  @@map("reminder_rules")
}

model RsvpAnswer {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rsvpId     String       @map("rsvp_id") @db.Uuid
  questionId String       @map("question_id") @db.Uuid
  value      Json
  question   RsvpQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "rsvp_answers_question_id_rsvp_questions_id_fk")
  rsvp       Rsvp         @relation(fields: [rsvpId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "rsvp_answers_rsvp_id_rsvps_id_fk")

  @@unique([rsvpId, questionId], map: "rsvp_answers_rsvp_question_uq")
  @@index([questionId], map: "rsvp_answers_question_idx")
  @@map("rsvp_answers")
}

model RsvpQuestion {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String       @map("event_id") @db.Uuid
  label       String
  type        QuestionType
  options     Json         @default("[]")
  required    Boolean      @default(false)
  rsvpAnswers RsvpAnswer[]
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "rsvp_questions_event_id_events_id_fk")

  @@index([eventId], map: "rsvp_questions_event_idx")
  @@map("rsvp_questions")
}

model Rsvp {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId            String            @map("event_id") @db.Uuid
  ticketTypeId       String?           @map("ticket_type_id") @db.Uuid
  inviteId           String?           @map("invite_id") @db.Uuid
  name               String
  email              String
  response           RsvpResponse
  status             RsvpStatus
  plusOnes           Int               @default(0) @map("plus_ones") @db.SmallInt
  seats              Int               @default(1) @db.SmallInt
  ticketCode         String            @unique(map: "rsvps_ticket_code_uq") @map("ticket_code") @db.VarChar(8)
  manageToken        String            @unique(map: "rsvps_manage_token_uq") @map("manage_token")
  marketingConsent   Boolean           @default(false) @map("marketing_consent")
  checkedInAt        DateTime?         @map("checked_in_at") @db.Timestamptz(6)
  attended           Boolean?
  waitlistPosition   Int?              @map("waitlist_position")
  claimExpiresAt     DateTime?         @map("claim_expires_at") @db.Timestamptz(6)
  source             RsvpSource        @default(direct)
  utmSource          String?           @map("utm_source")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  confirmedAt        DateTime?         @map("confirmed_at") @db.Timestamptz(6)
  consentConfirmedAt DateTime?         @map("consent_confirmed_at") @db.Timestamptz(6)
  messageDeliveries  MessageDelivery[]
  pollVotes          PollVote[]
  ticketOrders       TicketOrder[]
  rsvpAnswers        RsvpAnswer[]
  event              Event             @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "rsvps_event_id_events_id_fk")
  invite             Invite?           @relation(fields: [inviteId], references: [id], onUpdate: NoAction, map: "rsvps_invite_id_invites_id_fk")
  ticketType         TicketType?       @relation(fields: [ticketTypeId], references: [id], onUpdate: NoAction, map: "rsvps_ticket_type_id_ticket_types_id_fk")

  @@unique([eventId, email], map: "rsvps_event_email_uq")
  @@index([updatedAt], map: "rsvps_awaiting_payment_idx", where: raw("(status = 'awaiting_payment'::rsvp_status)"))
  @@index([eventId, status], map: "rsvps_event_status_idx")
  @@index([inviteId], map: "rsvps_invite_idx")
  @@index([ticketTypeId], map: "rsvps_ticket_type_idx")
  @@index([claimExpiresAt], map: "rsvps_waitlist_claim_idx", where: raw("((status = 'waitlisted'::rsvp_status) AND (claim_expires_at IS NOT NULL))"))
  @@map("rsvps")
}

model TicketType {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId    String    @map("event_id") @db.Uuid
  name       String
  priceCents Int       @default(0) @map("price_cents")
  currency   String    @default("USD") @db.VarChar(3)
  quantity   Int?
  salesEndAt DateTime? @map("sales_end_at") @db.Timestamptz(6)
  rsvps      Rsvp[]
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "ticket_types_event_id_events_id_fk")

  @@index([eventId], map: "ticket_types_event_idx")
  @@map("ticket_types")
}

model WebhookEndpoint {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  url         String
  secret      String
  events      Json      @default("[]")
  active      Boolean   @default(true)
  name        String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastStatus  Int?      @map("last_status")
  lastDeliveryAt DateTime? @map("last_delivery_at") @db.Timestamptz(6)

  @@map("webhook_endpoints")
}

enum DeliveryStatus {
  queued
  sent
  failed

  @@map("delivery_status")
}

enum EventFormat {
  in_person
  online
  hybrid

  @@map("event_format")
}

enum EventStatus {
  draft
  published
  cancelled

  @@map("event_status")
}

enum EventVisibility {
  public
  unlisted
  private

  @@map("event_visibility")
}

enum FontPreset {
  inter
  serif
  rounded

  @@map("font_preset")
}

enum InviteStatus {
  queued
  sent
  bounced
  responded

  @@map("invite_status")
}

enum PollStatus {
  draft
  open
  closed

  @@map("poll_status")
}

enum PollType {
  single_choice
  multi_choice
  rating
  short_text

  @@map("poll_type")
}

enum QuestionType {
  short_text
  long_text
  single_choice
  multi_choice
  checkbox

  @@map("question_type")
}

enum ReminderKind {
  confirmation
  reminder
  live_now
  thank_you

  @@map("reminder_kind")
}

enum RsvpResponse {
  going
  maybe
  not_going

  @@map("rsvp_response")
}

enum RsvpSource {
  direct
  invite
  host_page

  @@map("rsvp_source")
}

enum RsvpStatus {
  pending
  confirmed
  waitlisted
  declined
  cancelled
  awaiting_payment

  @@map("rsvp_status")
}

enum Segment {
  going
  maybe
  waitlisted
  pending
  checked_in
  no_show
  all

  @@map("segment")
}

/// The site's event settings: one row (id 1). Branding and defaults that used to live on the
/// workspace. The site NAME and LOGO still come from the platform (`GET /site-api/site`).
model EventSettings {
  id                   Int        @id @default(1)
  brandColor           String?    @map("brand_color") @db.VarChar(7)
  fontPreset           FontPreset @default(inter) @map("font_preset")
  defaultTimezone      String     @default("UTC") @map("default_timezone") @db.VarChar(64)
  senderName           String     @default("") @map("sender_name") @db.VarChar(80)
  replyToEmail         String     @default("") @map("reply_to_email") @db.VarChar(254)
  defaultReminderRules Json       @default("[]") @map("default_reminder_rules")
  allowMaybeDefault    Boolean    @default(true) @map("allow_maybe_default")
  showGuestListDefault Boolean    @default(false) @map("show_guest_list_default")
  defaultCoverPoster   String?    @map("default_cover_poster")
  updatedAt            DateTime   @default(now()) @updatedAt @map("updated_at")

  @@map("event_settings")
}

/// A ticket purchase for an RSVP. `checkoutId` is the platform's `pcs_…` (payments.md); the
/// template's own `orders` table keeps the generic record.
model TicketOrder {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rsvpId      String   @map("rsvp_id") @db.Uuid
  checkoutId  String   @unique @map("checkout_id") @db.VarChar(80)
  amountCents Int      @map("amount_cents")
  currency    String   @db.VarChar(3)
  seats       Int      @default(1) @db.SmallInt
  /// pending | paid | refunded | expired | refund_due
  status      String   @default("pending") @db.VarChar(16)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  rsvp        Rsvp     @relation(fields: [rsvpId], references: [id], onDelete: Cascade)

  @@index([rsvpId])
  @@map("ticket_orders")
}
